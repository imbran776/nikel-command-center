# .env.example
# Remove real credential values and replace with placeholders
# VITE_SUPABASE_URL="https://your-supabase-url"
# VITE_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# VITE_GOOGLE_CLIENT_ID="your-google-client-id"
# VITE_GOOGLE_AUTH_PROXY="your-google-auth-proxy"
# FULLSTACK_PROJECT_REF="your-project-ref"
# FULLSTACK_RESTORE_API_URL="your-restore-api-url"

# Example: VITE_SUPABASE_URL="https://example.supabase.co"
# VITE_SUPABASE_ANON_KEY="sb_public_XXXXX"
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_XXXXX"
# VITE_GOOGLE_CLIENT_ID="1234567890-abcdefg.apps.googleusercontent.com"
# VITE_GOOGLE_AUTH_PROXY="https://your-domain.io/auth/google/callback"
# FULLSTACK_PROJECT_REF="xxxxxxxx"
# FULLSTACK_RESTORE_API_URL="https://api.yourdomain.io/fullstack-restore"
